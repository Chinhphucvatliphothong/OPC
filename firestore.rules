rules_version = '2';

// Quy tắc bảo mật Firestore cho OPC Luyện Thi Vật Lí (project opcluyenthivatli).
// Nơi dán: Firebase Console → Firestore Database → tab "Rules" → Publish.
//
// SỬA 25/9/2026 — CHUYỂN SANG FIREBASE AUTHENTICATION THẬT cho học sinh
// (chuẩn bị mở rộng ra ngoài lớp quen biết): trước đây học sinh đăng nhập
// bằng cách so khớp username/mật khẩu ngay trên trình duyệt, không qua Auth
// thật, nên rules phải mở "get" công khai cho usernames/students/de_thi —
// ai biết đúng ID/username đều đọc được (kể cả toàn bộ ngân hàng đề + đáp
// án), và attempts/student_stats ai cũng ghi được không cần biết gì cả. Đây
// từng là lựa chọn CHỦ ĐỘNG để triển khai nhanh cho 1 lớp nhỏ, quen biết —
// không còn phù hợp khi bắt đầu dùng tên miền thật + nạp đầy đủ ngân hàng đề.
//
// Từ bản này: loginStudent (opc-live-data.js) gọi api/student-login.js —
// server (Firebase Admin SDK, không bị rules chi phối) kiểm tra mật khẩu rồi
// cấp Custom Token — nên request.auth.uid CHÍNH XÁC là studentId của em đang
// đăng nhập. Rules dưới đây dựa vào đó để khoá:
//   - "usernames": không còn ai cần đọc trực tiếp nữa (server tự tra bằng
//     Admin SDK) — chỉ admin.
//   - "students/{id}", "attempts", "assignedExams", "student_stats": đọc/ghi
//     CHỈ đúng em học sinh đang đăng nhập (request.auth.uid == studentId)
//     hoặc admin — không ai đọc/ghi được của bạn khác nữa.
//   - "de_thi" (ngân hàng đề + đáp án): đọc CHỈ khi đã đăng nhập thật (bất
//     kỳ học sinh nào, không giới hạn theo từng em vì đề dùng chung cho cả
//     lớp) — không còn đọc được mà không cần tài khoản.
// "registrations" (đăng ký lớp thử nghiệm) và "settings" (giá gói dịch vụ
// hiển thị công khai trên trang chủ) giữ nguyên công khai như trước — đúng
// bản chất là chưa cần tài khoản.

service cloud.firestore {
  match /databases/{database}/documents {

    // Chỉ (các) email trong danh sách này được toàn quyền quản trị dữ liệu
    // OPC. Thêm email nếu sau này có thêm admin (vd. trợ giảng).
    function isOpcAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['vovanthai2018tv@gmail.com', 'chinhphucvatliphothong@gmail.com'];
    }

    // Đúng học sinh đang đăng nhập (Custom Token từ api/student-login.js có
    // uid == studentId — xem ghi chú đầu file).
    function isSelf(studentId) {
      return request.auth != null && request.auth.uid == studentId;
    }

    // Bất kỳ ai đã đăng nhập thật (học sinh HOẶC admin) — dùng cho dữ liệu
    // dùng chung, không thuộc riêng 1 em (ngân hàng đề, mặt bằng chung).
    function isSignedIn() {
      return request.auth != null;
    }

    // Ánh xạ username -> studentId. Từ 25/9/2026 chỉ còn server (Admin SDK,
    // api/student-login.js) đọc trực tiếp lúc đăng nhập — Admin SDK không bị
    // rules chi phối nên KHÔNG cần "get" công khai ở đây nữa. Client không
    // còn đọc collection này trực tiếp.
    match /usernames/{username} {
      allow get, list: if isOpcAdmin();
      allow write: if isOpcAdmin();
    }

    // Hồ sơ học sinh (mật khẩu — nay đã mã hoá bcrypt sau lần đăng nhập đầu
    // kể từ bản này, SĐT, thông tin phụ huynh, mã giới thiệu, số dư hoa
    // hồng...). Chỉ đúng em đó (đọc lại hồ sơ của chính mình) hoặc admin đọc
    // được — không còn công khai. "list" (liệt kê cả lớp) vẫn chỉ admin.
    match /students/{studentId} {
      allow get: if isOpcAdmin() || isSelf(studentId);
      allow list: if isOpcAdmin();
      // Ghi vẫn chỉ admin qua admin.html — RIÊNG loginFailCount/loginLockUntil/
      // password (mã hoá lại lần đầu) do api/student-login.js ghi qua Admin
      // SDK, không qua đường rules này (Admin SDK bỏ qua rules).
      allow write: if isOpcAdmin();

      // Lịch sử luyện tập thật (điểm số + đúng/sai từng câu). Từ 25/9/2026:
      // chỉ đúng em đó (đọc/ghi kết quả của chính mình) hoặc admin (xem để
      // chấm/giám sát) — không ai đọc/ghi được của bạn khác nữa.
      match /attempts/{attemptId} {
        allow read, write: if isOpcAdmin() || isSelf(studentId);
      }

      // Đề cá nhân hóa mà giáo viên GIAO cho học sinh này. Đọc: đúng em đó
      // hoặc admin. Ghi: chỉ admin (chỉ giáo viên mới được giao đề) — không đổi.
      match /assignedExams/{examId} {
        allow read: if isOpcAdmin() || isSelf(studentId);
        allow write: if isOpcAdmin();
      }

      // Báo cáo phụ huynh do OPC Learning AI soạn — phụ huynh không có tài
      // khoản đăng nhập nên vẫn chỉ admin đọc/ghi, không đổi.
      match /parentReports/{reportId} {
        allow read, write: if isOpcAdmin();
      }

      // Kết quả luyện đề HSG/Olympic (tự chấm) của chính em đó — tách khỏi
      // "attempts" để không lẫn vào số liệu luyện thi Vật lí 12. (SỬA 1/10/2026:
      // bản 30/9 đặt nhầm khối này vào student_stats nên không lưu được.)
      match /specialAttempts/{attemptId} {
        allow read, write: if isOpcAdmin() || isSelf(studentId);
      }

      // THÊM 16/10/2026 — em đã xem video thầy chữa câu nào, bao nhiêu % (video-walkthrough.js ghi qua
      // OPC_LIVE.recordVideoView). Chỉ đúng em đó (ghi lượt xem của chính mình) hoặc admin (xem + báo cáo phụ huynh).
      match /videoViews/{qId} {
        allow read, write: if isOpcAdmin() || isSelf(studentId);
      }

      // THÊM 25/10/2026 — THÙNG RÁC bài làm: thầy xoá bài em làm thử/làm ẩu (khôi phục được). Chỉ thầy.
      match /attemptsTrash/{attemptId} {
        allow read, write: if isOpcAdmin();
      }

      // THÊM 23/10/2026 — em đã mở/xem hết bài giảng lý thuyết nào (student-extras.js · faraday-extras.js)
      match /lessonViews/{lessonId} {
        allow read, write: if isOpcAdmin() || isSelf(studentId);
      }
    }

    // Đăng ký lớp thử nghiệm từ trang giới thiệu công khai (index.html) —
    // "create" vẫn công khai (chưa có tài khoản gì để xác thực lúc này) —
    // giữ nguyên giới hạn chặt: chỉ đúng các trường liệt kê, đúng kiểu dữ
    // liệu, và status phải là 'pending'. Đọc/sửa/xoá (duyệt, từ chối) CHỈ
    // admin — không đổi.
    // THÊM 12/10/2026 — Bài kiểm tra trên lớp (đề giấy nhiều mã đề + kết quả quét phiếu cả lớp). Có ĐÁP ÁN nên chỉ admin.
    match /class_tests/{testId} {
      allow read, write: if isOpcAdmin();
    }

    match /registrations/{regId} {
      allow create: if request.resource.data.keys().hasOnly(['name','gmail','phone','parentZalo','referralCode','status','createdAt','source'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
        && request.resource.data.gmail is string && request.resource.data.gmail.size() < 120
        && request.resource.data.phone is string && request.resource.data.phone.size() < 20
        && request.resource.data.parentZalo is string && request.resource.data.parentZalo.size() < 20
        && request.resource.data.referralCode is string && request.resource.data.referralCode.size() < 30
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isOpcAdmin();
    }

    // THÊM 20/10/2026 — TRANG TIẾN ĐỘ PHỤ HUYNH (/phuhuynh?t=<mã>): ảnh chụp số liệu 1 em do admin ghi.
    // Chỉ cho "get" đúng 1 mã (24 ký tự ngẫu nhiên) — KHÔNG cho "list" nên không ai dò được danh sách học sinh.
    match /parent_views/{viewId} {
      allow get: if true;
      allow list: if false;
      allow write: if isOpcAdmin();
    }

    // THÊM 24/10/2026 — TRANG CHỦ BÁN HÀNG: ảnh lớp học thật (thầy đăng, đã có sự đồng ý) — ai cũng xem được.
    match /proof_photos/{photoId} {
      allow read: if true;
      allow write: if isOpcAdmin();
    }
    // Đặt lịch tư vấn 15 phút từ trang chủ (khách chưa đăng nhập): CHỈ được tạo, đúng các trường, giới hạn độ dài.
    match /bookings/{bookingId} {
      allow create: if request.resource.data.keys().hasOnly(['role','name','student','phone','slot','when','note','source','src','status','createdAt'])
        && request.resource.data.role in ['ph', 'hs']
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.student is string && request.resource.data.student.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.slot is string && request.resource.data.slot.size() <= 20
        && request.resource.data.when is string && request.resource.data.when.size() <= 80
        && request.resource.data.note is string && request.resource.data.note.size() <= 400
        && request.resource.data.source is string && request.resource.data.source.size() <= 20
        && request.resource.data.src is string && request.resource.data.src.size() <= 40
        && request.resource.data.status == 'new';
      allow read, update, delete: if isOpcAdmin();
    }

    // THÊM 23/10/2026 — THƯ VIỆN VIDEO BÀI GIẢNG (bài giảng FaradayAI + video YouTube ứng dụng thực tế):
    // học sinh đã đăng nhập đọc được; chỉ thầy thêm/sửa/xoá.
    match /video_lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isOpcAdmin();
      // THÊM 24/10/2026 — giọng đọc đã lưu (giọng AI / giọng thầy thu) của từng câu lời giảng
      match /audio/{clipId} {
        allow read: if isSignedIn();
        allow write: if isOpcAdmin();
      }
    }
    // THÊM 23/10/2026 — THI THỬ THÁNG: thông tin kỳ thi + bảng xếp hạng (tên rút gọn) thầy công bố.
    match /mock_exams/{mockId} {
      allow read: if isSignedIn();
      allow write: if isOpcAdmin();
    }
    // THÊM 23/10/2026 — KHẢO SÁT HÀI LÒNG: em chỉ được GỬI phiếu của chính mình (đúng các trường, giới hạn độ dài);
    // đọc/xoá chỉ thầy. survey_state: lần hỏi/hoãn gần nhất của từng em (để không hỏi dồn dập).
    match /surveys/{surveyId} {
      allow create: if isSignedIn() && request.resource.data.studentId == request.auth.uid
        && request.resource.data.keys().hasOnly(['studentId','name','lop','rating','helpful','likes','improve','recommend','extra','trigger','attempts','createdAt'])
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && (!('improve' in request.resource.data) || (request.resource.data.improve is string && request.resource.data.improve.size() <= 1500))
        && (!('likes' in request.resource.data) || (request.resource.data.likes is list && request.resource.data.likes.size() <= 12));
      allow read, delete: if isOpcAdmin();
    }
    match /survey_state/{studentId} {
      allow read, write: if isOpcAdmin() || isSelf(studentId);
    }

    // THÊM 15/10/2026 — "Chẩn đoán 5 phút" trên trang chủ (khách chưa đăng nhập).
    // diag_leads: khách để lại liên hệ + kết quả — CHỈ được tạo (đúng các trường, giới hạn độ dài); admin đọc/sửa/xoá.
    match /diag_leads/{leadId} {
      allow create: if request.resource.data.keys().hasOnly(['name','phone','grade','school','target','correct','total','score10','weak','strong','seconds','src','status','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.grade is string && request.resource.data.grade.size() <= 10
        && request.resource.data.school is string && request.resource.data.school.size() <= 100
        && request.resource.data.target is string && request.resource.data.target.size() <= 10
        && request.resource.data.weak is string && request.resource.data.weak.size() <= 300
        && request.resource.data.strong is string && request.resource.data.strong.size() <= 300
        && request.resource.data.src is string && request.resource.data.src.size() <= 40
        && request.resource.data.status == 'new';
      allow read, update, delete: if isOpcAdmin();
    }
    // diag_events: đếm lượt bắt đầu / hoàn thành (không có thông tin cá nhân) để đo tỉ lệ chuyển đổi.
    match /diag_events/{evId} {
      allow create: if request.resource.data.keys().hasOnly(['type','createdAt','src','score'])
        && request.resource.data.type in ['start', 'finish', 'lead', 'book']
        && request.resource.data.src is string && request.resource.data.src.size() <= 40;
      allow read, delete: if isOpcAdmin();
    }

    // Cấu hình chung do admin quản lý (hiện có "settings/pricing" — giá/
    // tính năng gói dịch vụ hiển thị trên trang chủ). Đọc công khai vì trang
    // chủ chưa đăng nhập ai cũng xem giá được — không chứa gì nhạy cảm; ghi
    // chỉ admin — không đổi.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOpcAdmin();
    }

    // Số liệu học tập THẬT (mastery/điểm dự đoán/sổ câu sai) — snapshot mới
    // nhất do CHÍNH trang luyện tập của học sinh tự ghi sau mỗi lần nộp bài.
    // Từ 25/9/2026: ghi CHỈ đúng em đó (không ai giả mạo điểm cho bạn khác
    // được nữa); đọc cho phép MỌI người đã đăng nhập (không chỉ chính mình)
    // vì admin cần đọc toàn bộ collection 1 lần cho trang Giám sát, và mỗi
    // học sinh cần đọc của CẢ LỚP để tính "Mặt bằng chung" trên Radar 5
    // chiều (loadPeerRadar5) — nhưng phải đăng nhập thật mới đọc được,
    // không còn công khai cho người lạ như trước.
    match /student_stats/{studentId} {
      allow read: if isSignedIn();
      // SỬA 1/10/2026 — KHÔI PHỤC: học sinh ghi số liệu học tập của CHÍNH
      // MÌNH (mastery, điểm dự đoán, sổ câu sai, "cần thầy hỗ trợ"...) sau mỗi
      // lần nộp bài. Bản 30/9 xoá nhầm dòng này (tưởng là hồ sơ học sinh) nên
      // số liệu học tập không cập nhật được từ khi publish bản đó.
      allow write: if isOpcAdmin() || isSelf(studentId);
    }

    // Ngân hàng đề (kể cả đáp án): từ 25/9/2026 CHỈ đọc được khi đã đăng
    // nhập thật (học sinh hoặc admin) — không còn công khai cho bất kỳ ai
    // ghé trang mà chưa có tài khoản. Ghi vẫn chỉ admin (nạp/sửa/xoá đề qua
    // admin.html) — không đổi.
    // THÊM 30/9/2026 — NGÂN HÀNG ĐỀ RIÊNG cho HSG cấp tỉnh/TP và đội tuyển
    // Olympic: 2 collection TÁCH HẲN khỏi "de_thi" (luyện thi Vật lí 12) nên
    // không bao giờ lẫn vào luyện tập/thi thử thường. Học sinh chỉ đọc được
    // khi thầy đã mở khoá cho em đó: students/{uid}.specialAccess chứa
    // 'hsg' hoặc 'olympic' (admin bật/tắt trong tab "🏆 HSG & Olympic").
    function hasSpecialAccess(track) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        track in get(/databases/$(database)/documents/students/$(request.auth.uid)).data.get('specialAccess', []);
    }
    match /de_thi_hsg/{examId} {
      allow read: if isOpcAdmin() || hasSpecialAccess('hsg');
      allow write: if isOpcAdmin();
      match /images/{imageId} {
        allow read: if isOpcAdmin() || hasSpecialAccess('hsg');
        allow write: if isOpcAdmin();
      }
    }
    match /de_thi_olympic/{examId} {
      allow read: if isOpcAdmin() || hasSpecialAccess('olympic');
      allow write: if isOpcAdmin();
      match /images/{imageId} {
        allow read: if isOpcAdmin() || hasSpecialAccess('olympic');
        allow write: if isOpcAdmin();
      }
    }

    // THÊM 26/10/2026 — NGÂN HÀNG ĐỀ ĐGNL ĐHQG-HCM (V-ACT): chỉ em được thầy mở khoá 'dgnl' mới đọc được.
    match /de_thi_dgnl/{examId} {
      allow read: if isOpcAdmin() || hasSpecialAccess('dgnl');
      allow write: if isOpcAdmin();
      match /images/{imageId} {
        allow read: if isOpcAdmin() || hasSpecialAccess('dgnl');
        allow write: if isOpcAdmin();
      }
    }

    match /de_thi/{examId} {
      allow read: if isSignedIn();
      allow write: if isOpcAdmin();

      match /images/{imageId} {
        allow read: if isSignedIn();
        allow write: if isOpcAdmin();
      }
    }
  }
}
