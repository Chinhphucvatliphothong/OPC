rules_version = '2';

// Quy tắc bảo mật Firestore cho OPC Luyện Thi Vật Lí (project opcluyenthivatli).
// Nơi dán: Firebase Console → Firestore Database → tab "Rules" → Publish.
//
// ĐÃ CẬP NHẬT để trang học sinh (index.html) hoạt động với dữ liệu thật:
//  - Học sinh đăng nhập bằng username/mật khẩu (KHÔNG phải Firebase Auth
//    thật) nên cần đọc công khai (nhưng chỉ "get" — biết đúng ID mới đọc
//    được, không "list" được cả danh sách) 2 collection "usernames" và
//    "students".
//  - Ngân hàng đề (de_thi) cho phép đọc công khai để học sinh luyện tập,
//    vì chưa có Auth thật để giới hạn quyền xem theo từng học sinh.
//  - Mọi thao tác GHI (write) vẫn CHỈ dành cho 2 email admin — không đổi.
//
// Đánh đổi bảo mật cần biết: vì "get theo ID" là công khai, ai biết đúng
// username của một em vẫn có thể tự thử mật khẩu (không giới hạn số lần)
// và ai có link/ID đề thi vẫn đọc được toàn bộ nội dung + đáp án. Đây là
// lựa chọn triển khai nhanh; khi cần an toàn hơn nên chuyển sang Firebase
// Authentication thật (xem ghi chú trong opc-live-data.js).

service cloud.firestore {
  match /databases/{database}/documents {

    // Chỉ (các) email trong danh sách này được ghi dữ liệu OPC.
    // Thêm email nếu sau này có thêm admin (vd. trợ giảng).
    function isOpcAdmin() {
      return request.auth != null &&
        request.auth.token.email in ['vovanthai2018tv@gmail.com', 'chinhphucvatliphothong@gmail.com'];
    }

    // Ánh xạ username -> studentId, KHÔNG chứa thông tin nhạy cảm nào khác.
    // "get" công khai (phải biết đúng username) nhưng "list" (liệt kê toàn
    // bộ) vẫn chỉ admin — nên không ai quét được danh sách username.
    match /usernames/{username} {
      allow get: if true;
      allow list: if isOpcAdmin();
      allow write: if isOpcAdmin();
    }

    // Hồ sơ học sinh (có mật khẩu dạng thường, SĐT, thông tin phụ huynh...).
    // "get" công khai để trang học sinh kiểm tra mật khẩu lúc đăng nhập và
    // đọc lại hồ sơ của chính mình; "list" (liệt kê cả lớp) vẫn chỉ admin.
    match /students/{studentId} {
      allow get: if true;
      allow list: if isOpcAdmin();
      allow write: if isOpcAdmin();

      // Lịch sử luyện tập thật (điểm số + đúng/sai từng câu). Đọc/ghi công
      // khai vì chưa có Auth thật để xác minh "đúng là em học sinh đó đang
      // ghi" — cùng đánh đổi bảo mật với phần đăng nhập ở trên. Không chứa
      // thông tin nhạy cảm nào ngoài kết quả làm bài.
      match /attempts/{attemptId} {
        allow read: if true;
        allow write: if true;
      }

      // Đề cá nhân hóa mà giáo viên GIAO cho học sinh này (từ panel "Tạo đề
      // theo lộ trình cá nhân hóa" trong admin.html) để em làm trực tiếp
      // trên web, không cần tải file. Khác với "attempts"/"student_stats" ở
      // trên: admin.html đăng nhập bằng Firebase Auth THẬT (isOpcAdmin) nên
      // GHI chỉ dành cho admin — chặt hơn, vì chỉ giáo viên mới được giao đề.
      // Đọc vẫn công khai (cùng lý do chưa có Auth thật cho học sinh).
      match /assignedExams/{examId} {
        allow read: if true;
        allow write: if isOpcAdmin();
      }

      // Báo cáo phụ huynh do OPC Learning AI soạn (draft) rồi thầy cô duyệt/
      // sửa/đánh dấu đã gửi qua Zalo cá nhân — THÊM 24/9/2026, xem
      // api/ai-parent-report.js + panel "Báo cáo Phụ huynh" trong admin.html.
      // Phụ huynh KHÔNG có tài khoản đăng nhập (quyết định đã chốt) nên
      // không cần đọc công khai — chỉ admin đọc/ghi, khác hẳn attempts/
      // assignedExams ở trên.
      match /parentReports/{reportId} {
        allow read, write: if isOpcAdmin();
      }
    }

    // Đăng ký lớp thử nghiệm từ trang giới thiệu công khai (index.html) —
    // THÊM 24/9/2026, thay cho luồng mailto cũ (gửi thẳng mật khẩu qua
    // email, không lưu gì lại). "create" công khai (học sinh chưa có tài
    // khoản/Auth gì để xác thực) nhưng bị giới hạn CHẶT hơn "attempts" ở
    // trên: chỉ được set đúng các trường liệt kê dưới, đúng kiểu dữ liệu,
    // và status phải là 'pending' (không tự ý tạo bản ghi đã 'converted').
    // Đọc/sửa/xoá (duyệt, từ chối) CHỈ admin — đây là hàng chờ nội bộ, học
    // sinh gửi xong không đọc lại được của mình hay của người khác.
    match /registrations/{regId} {
      allow create: if request.resource.data.keys().hasOnly(['name','gmail','phone','parentZalo','referralCode','status','createdAt','source'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 100
        && request.resource.data.gmail is string && request.resource.data.gmail.size() < 120
        && request.resource.data.phone is string && request.resource.data.phone.size() < 20
        && request.resource.data.parentZalo is string && request.resource.data.parentZalo.size() < 20
        && request.resource.data.referralCode is string && request.resource.data.referralCode.size() < 30
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isOpcAdmin();
    }

    // Cấu hình chung do admin quản lý qua panel trong admin.html — hiện có
    // "settings/pricing" (giá/tính năng/ẩn-hiện của mục "Gói dịch vụ" trên
    // trang chủ, xem panel "💰 Gói dịch vụ" + hàm loadPricingPlans trong
    // opc-live-data.js). Đọc công khai vì trang chủ chưa đăng nhập ai cũng
    // xem được; ghi chỉ admin. Dùng {settingId} chung để sau này thêm cấu
    // hình khác (vd. thông báo trang chủ) không cần sửa rules nữa.
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isOpcAdmin();
    }

    // Số liệu học tập THẬT (mastery/điểm dự đoán/sổ câu sai) — snapshot mới
    // nhất do CHÍNH trang luyện tập của học sinh tự ghi lại sau mỗi lần nộp
    // bài (xem OPC_LIVE.saveStudentStats trong opc-live-data.js), để trang
    // admin (PrepScholarMonitoringPanel) đọc TOÀN BỘ collection 1 lần thay
    // vì đọc attempts của từng học sinh. Đọc/ghi công khai — cùng đánh đổi
    // bảo mật với "attempts" ở trên vì chưa có Auth thật cho học sinh.
    match /student_stats/{studentId} {
      allow read: if true;
      allow write: if true;
    }

    // Ngân hàng đề: đọc công khai (get + list) để học sinh luyện tập; ghi
    // vẫn chỉ admin (nạp/sửa/xoá đề qua admin.html).
    match /de_thi/{examId} {
      allow read: if true;
      allow write: if isOpcAdmin();

      match /images/{imageId} {
        allow read: if true;
        allow write: if isOpcAdmin();
      }
    }
  }
}
